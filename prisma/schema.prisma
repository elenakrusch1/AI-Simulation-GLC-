// Data Center Deal Simulation — database schema
//
// Design notes:
// - UUID primary keys throughout (generated by Prisma, stored as
//   native Postgres `uuid`).
// - `Session` is an addition beyond the brief's explicit model list:
//   it backs real server-side sessions (see src/lib/auth/session.ts)
//   rather than a client-held JWT.
// - Team-safe vs admin-only data is separated at the query layer
//   (src/lib/data/*), not by field-level hiding here — every model
//   that must stay invisible to teams (ScoringRule, ScoreBreakdown,
//   ScoreResult internals, AuditLog, ManualScoreAdjustment) is only
//   ever queried from admin-only server code.
// - Deleting a User never cascades into AuditLog (onDelete: SetNull)
//   so the audit trail survives account changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEAM
  ADMIN
}

enum RoundStatus {
  NOT_STARTED
  OPEN
  CLOSED
  LOCKED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum CustomerRole {
  PRIMARY
  SECONDARY
}

enum ScoringModelStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ScoringRuleType {
  BASE
  COMBINATION
  BONUS
  PENALTY
  MANUAL_CATEGORY
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  loginIdentifier  String    @unique
  passwordHash     String
  role             Role
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  team                        Team?
  sessions                    Session[]
  createdScoringModelVersions ScoringModelVersion[]    @relation("ScoringModelCreatedBy")
  manualAdjustmentsCreated    ManualScoreAdjustment[]  @relation("ManualAdjustmentCreatedBy")
  leaderboardPublicationsMade LeaderboardPublication[] @relation("LeaderboardPublishedBy")
  auditLogs                   AuditLog[]

  @@index([role])
}

/// Opaque, DB-backed server-side session. The cookie only ever holds
/// a high-entropy random token; `tokenHash` (SHA-256 of that token) is
/// what is stored here, so a database leak alone cannot be replayed
/// as a live session.
model Session {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String   @unique
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  lastRotatedAt DateTime @default(now())
  ipAddress     String?
  userAgent     String?

  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions        Submission[]
  scoreResults       ScoreResult[]
  manualAdjustments  ManualScoreAdjustment[]
  leaderboardEntries LeaderboardEntry[]

  @@index([active])
}

model Round {
  id             String      @id @default(uuid()) @db.Uuid
  number         Int         @unique
  slug           String      @unique
  name           String
  status         RoundStatus @default(NOT_STARTED)
  editingAllowed Boolean     @default(false)
  openedAt       DateTime?
  closedAt       DateTime?
  lockedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  submissions       Submission[]
  scoreResults      ScoreResult[]
  manualAdjustments ManualScoreAdjustment[]

  @@index([status])
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roundOnePrimaryFor   RoundOneDecision[] @relation("RoundOnePrimary")
  roundOneSecondaryFor RoundOneDecision[] @relation("RoundOneSecondary")
  roundTwoDecisions    RoundTwoDecision[]
  scoringRules         ScoringRule[]

  @@index([active])
}

model TechnicalSolution {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  roundTwoDecisions RoundTwoDecision[]
  scoringRules      ScoringRule[]

  @@index([active])
}

model CommercialModel {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  roundTwoDecisions RoundTwoDecision[]
  scoringRules      ScoringRule[]

  @@index([active])
}

model Submission {
  id          String           @id @default(uuid()) @db.Uuid
  teamId      String           @db.Uuid
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  roundId     String           @db.Uuid
  round       Round            @relation(fields: [roundId], references: [id], onDelete: Cascade)
  status      SubmissionStatus @default(DRAFT)
  submittedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roundOneDecision  RoundOneDecision?
  roundTwoDecisions RoundTwoDecision[]

  @@unique([teamId, roundId])
  @@index([roundId, status])
}

model RoundOneDecision {
  id                  String     @id @default(uuid()) @db.Uuid
  submissionId        String     @unique @db.Uuid
  submission          Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  primaryCustomerId   String     @db.Uuid
  primaryCustomer     Customer   @relation("RoundOnePrimary", fields: [primaryCustomerId], references: [id])
  secondaryCustomerId String     @db.Uuid
  secondaryCustomer   Customer   @relation("RoundOneSecondary", fields: [secondaryCustomerId], references: [id])
  rationale           String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([primaryCustomerId])
  @@index([secondaryCustomerId])
}

model RoundTwoDecision {
  id                  String            @id @default(uuid()) @db.Uuid
  submissionId        String            @db.Uuid
  submission          Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  customerId          String            @db.Uuid
  customer            Customer          @relation(fields: [customerId], references: [id])
  customerRole        CustomerRole
  technicalSolutionId String            @db.Uuid
  technicalSolution   TechnicalSolution @relation(fields: [technicalSolutionId], references: [id])
  commercialModelId   String            @db.Uuid
  commercialModel     CommercialModel   @relation(fields: [commercialModelId], references: [id])
  rationale           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([submissionId, customerRole])
  @@index([customerId])
  @@index([technicalSolutionId])
  @@index([commercialModelId])
}

/// Only one version may have status = ACTIVE. Enforced in the service
/// layer (activating one archives any other ACTIVE version inside the
/// same transaction) and backstopped by a partial unique index added
/// in a follow-up migration (see prisma/migrations).
model ScoringModelVersion {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  status          ScoringModelStatus @default(DRAFT)
  createdByUserId String             @db.Uuid
  createdByUser   User               @relation("ScoringModelCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime           @default(now())
  activatedAt     DateTime?
  archivedAt      DateTime?

  rules        ScoringRule[]
  scoreResults ScoreResult[]

  @@index([status])
}

model ScoringRule {
  id                    String              @id @default(uuid()) @db.Uuid
  externalRuleId        String?
  scoringModelVersionId String              @db.Uuid
  scoringModelVersion   ScoringModelVersion @relation(fields: [scoringModelVersionId], references: [id], onDelete: Cascade)
  roundNumber           Int
  customerId            String?             @db.Uuid
  customer              Customer?           @relation(fields: [customerId], references: [id])
  customerRole          CustomerRole?
  technicalSolutionId   String?             @db.Uuid
  technicalSolution     TechnicalSolution?  @relation(fields: [technicalSolutionId], references: [id])
  commercialModelId     String?             @db.Uuid
  commercialModel       CommercialModel?    @relation(fields: [commercialModelId], references: [id])
  ruleType              ScoringRuleType
  points                Int
  active                Boolean             @default(true)
  adminNote             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  breakdowns ScoreBreakdown[]

  @@index([scoringModelVersionId, roundNumber])
  @@index([customerId])
}

model ScoreResult {
  id                    String              @id @default(uuid()) @db.Uuid
  teamId                String              @db.Uuid
  team                  Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  roundId               String              @db.Uuid
  round                 Round               @relation(fields: [roundId], references: [id], onDelete: Cascade)
  scoringModelVersionId String              @db.Uuid
  scoringModelVersion   ScoringModelVersion @relation(fields: [scoringModelVersionId], references: [id])
  calculatedScore       Int
  calculatedAt          DateTime            @default(now())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  breakdowns ScoreBreakdown[]

  @@unique([teamId, roundId, scoringModelVersionId])
  @@index([roundId])
}

/// Admin-only. Never queried from any team-facing code path.
model ScoreBreakdown {
  id                  String      @id @default(uuid()) @db.Uuid
  scoreResultId       String      @db.Uuid
  scoreResult         ScoreResult @relation(fields: [scoreResultId], references: [id], onDelete: Cascade)
  scoringRuleId       String      @db.Uuid
  scoringRule         ScoringRule @relation(fields: [scoringRuleId], references: [id])
  points              Int
  internalDescription String
  createdAt           DateTime    @default(now())

  @@index([scoreResultId])
}

model ManualScoreAdjustment {
  id              String   @id @default(uuid()) @db.Uuid
  teamId          String   @db.Uuid
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  roundId         String?  @db.Uuid
  round           Round?   @relation(fields: [roundId], references: [id])
  amount          Int
  reason          String
  createdByUserId String   @db.Uuid
  createdByUser   User     @relation("ManualAdjustmentCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([teamId, roundId])
}

model LeaderboardPublication {
  id                String   @id @default(uuid()) @db.Uuid
  title             String
  visible           Boolean  @default(false)
  frozen            Boolean  @default(false)
  /// Structured JSON, e.g. { "roundIds": ["..."] } — which rounds'
  /// scores are reflected in this snapshot.
  includedRounds    Json
  publishedByUserId String   @db.Uuid
  publishedByUser   User     @relation("LeaderboardPublishedBy", fields: [publishedByUserId], references: [id])
  publishedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  entries LeaderboardEntry[]

  @@index([visible])
}

model LeaderboardEntry {
  id             String                 @id @default(uuid()) @db.Uuid
  publicationId  String                 @db.Uuid
  publication    LeaderboardPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  teamId         String                 @db.Uuid
  team           Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rank           Int
  publishedScore Int
  tied           Boolean                @default(false)
  createdAt      DateTime               @default(now())

  @@unique([publicationId, teamId])
  @@index([publicationId, rank])
}

/// Never cascaded on User deletion (onDelete: SetNull) so the trail
/// outlives the account that produced it.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  reason        String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}
