# Copy this file to .env for local development:
#   cp .env.example .env
#
# For Docker Compose, the same variables can instead be placed in a
# .env file at the repo root (Compose reads it automatically) or
# exported in your shell; see docker-compose.yml for the defaults it
# falls back to.

# PostgreSQL connection string. Required. In production this must
# point at a separate, persistent, managed PostgreSQL instance — the
# app container's own filesystem is ephemeral and must never be used
# for the database.
DATABASE_URL="postgresql://dcsim:dcsim_dev_password@127.0.0.1:5432/dcsim?schema=public"

# development | test | production. Controls secure-cookie behavior
# (Secure flag only set when NODE_ENV=production) and log verbosity.
NODE_ENV=development

# Port the server listens on. Koyeb/most platforms set this for you;
# defaults to 3000 if unset.
PORT=3000

# Name of the session cookie. Rarely needs to change.
SESSION_COOKIE_NAME=dcsim_session

# --- Admin account bootstrap ---
# Optional, but recommended for any real deployment (Docker Compose,
# Koyeb, or elsewhere). If both are set, docker-entrypoint.sh creates
# (or resets) this admin account automatically on every container
# boot — no `docker exec`/manual step needed to get an admin after
# hosting the app somewhere. Safe to leave set permanently: re-running
# it is an upsert, and it's how you recover admin access later too
# (just redeploy/restart with these set).
# The same two variables also work non-interactively with
# `npm run seed:admin` outside Docker. If unset there, the script
# prompts for them instead. Never commit real values here — this file
# only documents the variable names.
# ADMIN_LOGIN_IDENTIFIER=admin@example.com
# ADMIN_PASSWORD=

# --- Used only by docker-compose.yml (local Postgres container) ---
# POSTGRES_USER=dcsim
# POSTGRES_PASSWORD=dcsim_dev_password
# POSTGRES_DB=dcsim
# APP_PORT=3000
